{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "agent-activity",
  "name": "Agents Director",
  "version": "0.2.2",
  "description": "A rolling seven-day timeline of publicly observed Orca agent states and session summaries.",
  "engines": {
    "orca": ">=1.4.260"
  },
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "activity",
        "title": "Agents Director",
        "icon": "activity",
        "entry": "panel.html"
      }
    ],
    "customEditors": [
      {
        "id": "overview",
        "title": "Agents Director",
        "extensions": [".orca-activity"],
        "entry": "panel.html",
        "priority": "default"
      }
    ],
    "newFiles": [
      {
        "id": "overview",
        "title": "Agents Director",
        "extension": ".orca-activity",
        "template": "overview.orca-activity"
      }
    ],
    "commands": [
      {
        "id": "refresh",
        "title": "Agents Director: Refresh activity"
      }
    ],
    "hooks": [{ "event": "agent.tool.before" }, { "event": "agent.tool.after" }],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "history:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:launch"
    },
    {
      "kind": "storage:own"
    }
  ],
  "repository": "https://github.com/Kyino-Pan/agents-director",
  "homepage": "https://github.com/Kyino-Pan/agents-director",
  "license": "MIT",
  "author": {
    "name": "Kyino-Pan",
    "url": "https://github.com/Kyino-Pan"
  },
  "cover": {
    "path": "assets/cover.png",
    "alt": "Synthetic illustration of the Agents Director timeline. Illustrative coordination arrows."
  },
  "screenshots": [
    {
      "path": "assets/light.png",
      "alt": "Legacy synthetic timeline illustration; illustrative coordination arrows.",
      "theme": "light"
    },
    {
      "path": "assets/dark.png",
      "alt": "Legacy synthetic timeline illustration; illustrative coordination arrows.",
      "theme": "dark"
    }
  ]
}
